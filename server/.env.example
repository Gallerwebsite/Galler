# Backend — copy to server/.env for local development
FRONTEND_URL=http://localhost:3000
JWT_SECRET=change-me-in-production

# MongoDB Atlas (required in production on Render)
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/galler?retryWrites=true&w=majority

# Local ImageKit comparison — clone prod into a TEST database (never use prod as TARGET):
# MONGODB_URI_SOURCE=mongodb+srv://user:password@cluster.mongodb.net/galler?retryWrites=true&w=majority
# MONGODB_URI_TARGET=mongodb+srv://user:password@cluster.mongodb.net/galler-imagekit-test?retryWrites=true&w=majority
# Then: npm run clone-db
# After clone, set MONGODB_URI to the TARGET URI for local testing only.

# ImageKit (required for uploads in production)
# IMAGEKIT_PUBLIC_KEY=public_xxx
# IMAGEKIT_PRIVATE_KEY=private_xxx
# IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# Resend (required for form email notifications in production)
# RESEND_API_KEY=re_xxxxxxxx
# CONTACT_NOTIFY_EMAIL=you@example.com
# RESEND_FROM_EMAIL=Galler Website <onboarding@resend.dev>
# Legacy names still supported: CONTACT_TO_EMAIL, CONTACT_FROM_EMAIL, NEWSLETTER_FROM_EMAIL

# Production (Render dashboard): MUST match the live site origin (no trailing slash).
# Admin photo uploads fail with CORS if this is wrong / missing.
# FRONTEND_URL=https://gallerindia.com
# Optional comma-separated extras (e.g. preview deploys):
# FRONTEND_URLS=https://galler.vercel.app,https://galler-git-main.vercel.app
