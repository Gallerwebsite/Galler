# Backend — copy to server/.env for local development
FRONTEND_URL=http://localhost:3000
JWT_SECRET=change-me-in-production

# MongoDB Atlas (required in production on Render)
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/galler?retryWrites=true&w=majority

# Cloudinary (required in production for persistent uploads)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Resend (optional until domain is verified — subscribers are still saved without this)
# RESEND_API_KEY=re_xxxxxxxx
# CONTACT_TO_EMAIL=you@example.com
# CONTACT_FROM_EMAIL=Galler Website <onboarding@resend.dev>
# NEWSLETTER_FROM_EMAIL=Galler Website <onboarding@resend.dev>

# Production (Render dashboard): MUST match the live site origin (no trailing slash).
# Admin photo uploads fail with CORS if this is wrong / missing.
# FRONTEND_URL=https://gallerindia.com
# Optional comma-separated extras (e.g. preview deploys):
# FRONTEND_URLS=https://galler.vercel.app,https://galler-git-main.vercel.app
